# GEMINI_API_KEY: Required for server-side Gemini AI services.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL of the Humanity Connect deployment.
APP_URL="MY_APP_URL"

# Security & Session Signing (provide strong random secrets in production)
SESSION_SIGNING_SECRET="REPLACE_WITH_32_BYTE_RANDOM_HEX"
ENCRYPTION_MASTER_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# Super Admin credentials belong in environment secrets, never in source control.
# After database schema and reference roles are initialized, use:
#   npm run super-admin -- bootstrap
# Save the one-time MFA secret printed by the command in an authenticator app.
# For an existing Super Admin use `npm run super-admin -- rotate` instead. Rotation
# changes only its password, clears lockout and revokes its database sessions.
# Revoke Firebase sessions separately if the account also used Google sign-in.
# Remove these credentials from the environment after running the command.
# Deployments using the former hardcoded password must rotate it immediately.
# If an existing admin has not enabled MFA, enable it under Security & MFA after sign-in.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Alternatively, provision the first admin via POST /api/auth/provision-super-admin
# over a trusted connection, using this one-time token.
SUPER_ADMIN_PROVISION_SECRET="REPLACE_WITH_PROVISIONING_SECRET"

# Google sign-in requires the exact deployment hostname in Firebase Console >
# Authentication > Settings > Authorized domains. Email/password login does not.

# M-Pesa Daraja Integration (Kenya)
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""
MPESA_WEBHOOK_SECRET=""

# TalkSasa Bulk SMS & OTP Gateway (Kenya)
TALKSASA_API_URL="https://bulksms.talksasa.com/api/v3/sms/send"
TALKSASA_API_TOKEN=""
TALKSASA_SENDER_ID="HUMANITY"
TALKSASA_WEBHOOK_SECRET=""

# Optional Redis connection for BullMQ workers (falls back to PostgreSQL job queue when unset)
REDIS_URL=""

# Note: Cloud SQL PostgreSQL connection variables (SQL_HOST, SQL_DB_NAME, SQL_USER,
# SQL_PASSWORD, SQL_ADMIN_USER, SQL_ADMIN_PASSWORD) are injected by the runtime environment.
